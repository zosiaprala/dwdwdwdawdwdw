-- ============================================================
-- BUILT-IN PICTURE (embedded PNG, loaded with getcustomasset)
-- Only works where the executor provides writefile + getcustomasset.
-- Everywhere else, set CONFIG.BackgroundImage to an uploaded image ID.
-- ============================================================
local EMBEDDED_BACKGROUND_PNG = ""

local function decodeBase64(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do
        lookup[string.byte(alphabet, i)] = i - 1
    end

    local out, count = {}, 0
    local buffer, bits = 0, 0
    for i = 1, #data do
        local value = lookup[string.byte(data, i)]
        if value then
            buffer = buffer * 64 + value
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local divisor = 2 ^ bits
                count = count + 1
                out[count] = string.char(math.floor(buffer / divisor) % 256)
                buffer = buffer % divisor
            end
        end
    end
    return table.concat(out)
end

local function loadEmbeddedBackground()
    local write = writefile
    local asset = getcustomasset or getsynasset
    if not (write and asset) then return nil end

    local ok, result = pcall(function()
        write("popek_menu_bg.png", decodeBase64(EMBEDDED_BACKGROUND_PNG))
        return asset("popek_menu_bg.png")
    end)
    if ok and type(result) == "string" and result ~= "" then
        return result
    end
    return nil
end

