    FogColor = Color3.fromRGB(192, 192, 192),
    FogStart = 0,
    FogEnd = 1000,
}

local savedLighting = nil
local lightingColorCorrection = nil

local function applyOldLighting()
    if savedLighting then return end -- already applied

    -- Remember the game's current lighting so it can be restored exactly
    savedLighting = {}
    for _, prop in ipairs(LIGHTING_PROPS) do
        pcall(function() savedLighting[prop] = Lighting[prop] end)
    end

    for prop, value in pairs(OLD_LIGHTING) do
        pcall(function() Lighting[prop] = value end)
    end

    if not lightingColorCorrection then
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "PopekColorCorrection"
        cc.Brightness = 0.05
        cc.Contrast = 0.1
        cc.Saturation = 0.15
        cc.TintColor = Color3.fromRGB(245, 240, 255)
        cc.Parent = Lighting
        lightingColorCorrection = cc
    end
end

local function restoreLighting()
    if savedLighting then
        for prop, value in pairs(savedLighting) do
            pcall(function() Lighting[prop] = value end)
        end
        savedLighting = nil
    end
    if lightingColorCorrection then
        lightingColorCorrection:Destroy()
        lightingColorCorrection = nil
    end
end

